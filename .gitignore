# Terraform working directories and state
.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfplan.*
terraform.zip
plan-check-*.txt
tfplan-*

# Local Git metadata backups retained during repository consolidation.
environments/poc/.git.local-backup/
.local-agentic_sre_infra-backup/

# Application source: never commit local settings, build output, or artifacts.
applications/**/bin/
applications/**/obj/
applications/**/*.zip
applications/**/local.settings.json

# CI packages and Python validation output
dist/
__pycache__/
*.pyc

# Variable and backend files can contain tenant, subscription, or secret values
*.tfvars
*.tfvars.json
# Reviewed, non-secret POC configuration is versioned.
!environments/poc/terraform.tfvars
backend.hcl

# Keep the dependency lock file in source control
!.terraform.lock.hcl
